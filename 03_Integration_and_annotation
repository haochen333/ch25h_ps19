# Step 3: Integration, clustering, marker detection, and manual annotation
# Inputs: the 16 *_singlets_PCA.rds files generated by Step 2

library(Seurat)
library(ggplot2)
library(dplyr)
library(patchwork)
library(future)

set.seed(1234)

# Folder containing the singlet RDS files.
data_dir <- "/Volumes/haochen2026/00_single_nuclei_seq_data/04_LG253_CH25H_Tau_snRNAseq"
setwd(data_dir)

# Use conservative parallel settings to reduce memory duplication.
plan("multisession", workers = 4)
options(future.globals.maxSize = 60 * 1024^3)

sample_names <- c(
  "CT_1", "CT_2", "CT_3", "WT_4",
  "KO_1", "KO_2", "KO_3", "KO_4",
  "WT_Tau_1", "WT_Tau_2", "WT_Tau_3", "WT_Tau_4",
  "KO_Tau_1", "KO_Tau_2", "KO_Tau_3", "KO_Tau_4"
)

# Biological condition for every sample.
# This intentionally corrects WT_4, which was labeled KO in Step 1.
sample_to_condition <- c(
  CT_1 = "CT", CT_2 = "CT", CT_3 = "CT", WT_4 = "CT",
  KO_1 = "KO", KO_2 = "KO", KO_3 = "KO", KO_4 = "KO",
  WT_Tau_1 = "WT_Tau", WT_Tau_2 = "WT_Tau",
  WT_Tau_3 = "WT_Tau", WT_Tau_4 = "WT_Tau",
  KO_Tau_1 = "KO_Tau", KO_Tau_2 = "KO_Tau",
  KO_Tau_3 = "KO_Tau", KO_Tau_4 = "KO_Tau"
)

input_files <- paste0(sample_names, "_singlets_PCA.rds")
missing_files <- input_files[!file.exists(input_files)]
if (length(missing_files) > 0) {
  stop(
    "The following Step 2 files are missing:\n",
    paste(missing_files, collapse = "\n")
  )
}

# Load objects and repair sample/condition metadata from the authoritative map.
object_list <- lapply(seq_along(sample_names), function(i) {
  sample_name <- sample_names[i]
  object <- readRDS(input_files[i])
  DefaultAssay(object) <- "RNA"

  object$Sample_Name <- sample_name
  object$Condition <- unname(sample_to_condition[sample_name])
  object$orig.ident <- sample_name

  # Ensure every object has log-normalized RNA data and variable features.
  object <- NormalizeData(
    object,
    normalization.method = "LogNormalize",
    scale.factor = 10000,
    verbose = FALSE
  )
  object <- FindVariableFeatures(
    object,
    selection.method = "vst",
    nfeatures = 3000,
    verbose = FALSE
  )
  object
})
names(object_list) <- sample_names

# Verify that metadata were assigned correctly before integration.
metadata_check <- do.call(
  rbind,
  lapply(object_list, function(x) {
    data.frame(
      Sample_Name = unique(as.character(x$Sample_Name)),
      Condition = unique(as.character(x$Condition)),
      Singlets = ncol(x),
      stringsAsFactors = FALSE
    )
  })
)
write.csv(metadata_check, "integration_input_summary.csv", row.names = FALSE)
print(metadata_check)

# Canonical Seurat log-normalization/CCA integration across all 16 samples.
integration_features <- SelectIntegrationFeatures(
  object.list = object_list,
  nfeatures = 3000
)

anchors_all <- FindIntegrationAnchors(
  object.list = object_list,
  anchor.features = integration_features,
  reduction = "cca",
  dims = 1:30
)

all_integrated <- IntegrateData(
  anchorset = anchors_all,
  dims = 1:30
)

rm(anchors_all, object_list)
gc()

# PCA, graph construction, clustering, and UMAP use the integrated assay.
DefaultAssay(all_integrated) <- "integrated"
all_integrated <- ScaleData(all_integrated, verbose = FALSE)
all_integrated <- RunPCA(
  all_integrated,
  features = VariableFeatures(all_integrated),
  npcs = 50,
  verbose = FALSE
)

pdf("all_integrated_ElbowPlot.pdf", width = 8, height = 6)
print(ElbowPlot(all_integrated, ndims = 50))
dev.off()

# Change these after reviewing the elbow plot if necessary.
pcs_for_clustering <- 1:20
cluster_resolution <- 0.1

all_integrated <- FindNeighbors(
  all_integrated,
  dims = pcs_for_clustering
)
all_integrated <- FindClusters(
  all_integrated,
  resolution = cluster_resolution
)
all_integrated <- RunUMAP(
  all_integrated,
  dims = pcs_for_clustering
)

# Restore ordered metadata factors for plotting and downstream comparisons.
all_integrated$Condition <- factor(
  all_integrated$Condition,
  levels = c("CT", "KO", "WT_Tau", "KO_Tau")
)
all_integrated$Sample_Name <- factor(
  all_integrated$Sample_Name,
  levels = sample_names
)
Idents(all_integrated) <- "seurat_clusters"

saveRDS(all_integrated, "all_integrated_PCA_res0.1.rds")

# Integration/QC plots.
pdf("all_integrated_UMAP_clusters.pdf", width = 7, height = 5)
print(DimPlot(all_integrated, reduction = "umap", label = TRUE, repel = TRUE))
dev.off()

pdf("all_integrated_UMAP_by_condition.pdf", width = 12, height = 8)
print(
  DimPlot(
    all_integrated,
    reduction = "umap",
    group.by = "seurat_clusters",
    split.by = "Condition",
    label = TRUE,
    repel = TRUE,
    ncol = 2
  )
)
dev.off()

pdf("all_integrated_UMAP_by_sample.pdf", width = 16, height = 14)
print(
  DimPlot(
    all_integrated,
    reduction = "umap",
    group.by = "seurat_clusters",
    split.by = "Sample_Name",
    label = FALSE,
    ncol = 4
  )
)
dev.off()

DefaultAssay(all_integrated) <- "RNA"

pdf("all_QC_by_condition.pdf", width = 10, height = 5)
print(
  VlnPlot(
    all_integrated,
    features = c("nFeature_RNA", "nCount_RNA", "percent.mt"),
    group.by = "Condition",
    ncol = 3,
    pt.size = 0
  )
)
dev.off()

write.csv(
  as.data.frame(table(
    Cluster = all_integrated$seurat_clusters,
    Sample_Name = all_integrated$Sample_Name
  )),
  "cell_counts_cluster_by_sample.csv",
  row.names = FALSE
)

write.csv(
  as.data.frame(table(
    Cluster = all_integrated$seurat_clusters,
    Condition = all_integrated$Condition
  )),
  "cell_counts_cluster_by_condition.csv",
  row.names = FALSE
)

# Seurat v5 objects may contain split RNA layers. Join them before marker tests.
if (inherits(all_integrated[["RNA"]], "Assay5")) {
  all_integrated <- JoinLayers(all_integrated, assay = "RNA")
}

# Find cluster markers on non-integrated RNA expression.
Idents(all_integrated) <- "seurat_clusters"
all_markers <- FindAllMarkers(
  all_integrated,
  assay = "RNA",
  only.pos = TRUE,
  min.pct = 0.25,
  logfc.threshold = 0.25,
  test.use = "wilcox"
)
write.csv(all_markers, "all_cluster_markers.csv", row.names = FALSE)

fc_column <- if ("avg_log2FC" %in% colnames(all_markers)) {
  "avg_log2FC"
} else {
  "avg_logFC"
}

top10_markers <- all_markers %>%
  group_by(cluster) %>%
  slice_max(order_by = .data[[fc_column]], n = 10, with_ties = FALSE) %>%
  ungroup()
write.csv(top10_markers, "top10_markers_per_cluster.csv", row.names = FALSE)

# Marker panel used for the original broad cell-type annotation.
sig_EN <- c(
  "Snap25", "Slc17a7", "Nrgn", "Gad1", "Gad2", "Plp1", "Mbp", "Mobp",
  "Sntn", "Aqp4", "Clu", "Aldoc", "Pla2g7", "Cx3cr1", "P2ry12",
  "Csf1r", "Pdgfra", "Vcan", "Flt1", "Vtn", "Igfbp7"
)

# Plot only markers present in the RNA assay and report any missing markers.
markers_present <- sig_EN[sig_EN %in% rownames(all_integrated)]
markers_missing <- setdiff(sig_EN, markers_present)
if (length(markers_missing) > 0) {
  warning("Markers absent from the object: ", paste(markers_missing, collapse = ", "))
}
write.csv(
  data.frame(Marker = sig_EN, Present = sig_EN %in% markers_present),
  "annotation_marker_availability.csv",
  row.names = FALSE
)

pdf("all_annotation_combine.pdf", width = 10, height = 5)
print(
  DotPlot(all_integrated, features = rev(markers_present)) +
    RotatedAxis()
)
dev.off()

# Apply the cluster annotation supplied from the original analysis.
Idents(all_integrated) <- "seurat_clusters"

# Stop if the new integration did not reproduce the expected cluster IDs.
expected_clusters <- as.character(0:11)
observed_clusters <- levels(Idents(all_integrated))
if (!setequal(expected_clusters, observed_clusters)) {
  stop(
    "Expected clusters 0-11 were not all found. Observed clusters: ",
    paste(observed_clusters, collapse = ", "),
    ". Review all_annotation_combine.pdf before applying the manual mapping."
  )
}

# Remove cluster 11 because it was classified as unknown/mixed.
all_integrated <- subset(all_integrated, idents = "11", invert = TRUE)
Idents(all_integrated) <- "seurat_clusters"

all_integrated <- RenameIdents(
  all_integrated,
  `0` = "excitatory neurons",
  `1` = "excitatory neurons",
  `2` = "excitatory neurons",
  `3` = "oligodendrocytes",
  `4` = "astrocyte",
  `5` = "excitatory neurons",
  `6` = "inhibitory neurons",
  `7` = "vascular cells",
  `8` = "excitatory neurons",
  `9` = "microglia",
  `10` = "excitatory neurons"
)

all_integrated$celltype <- factor(
  as.character(Idents(all_integrated)),
  levels = c(
    "excitatory neurons",
    "inhibitory neurons",
    "oligodendrocytes",
    "astrocyte",
    "vascular cells",
    "microglia"
  )
)
all_integrated$celltype_sample <- paste(
  all_integrated$celltype,
  all_integrated$Sample_Name,
  sep = "_"
)

Idents(all_integrated) <- "celltype"

pdf("all_integrated_UMAP_annotation.pdf", width = 9, height = 6)
print(
  DimPlot(all_integrated, reduction = "umap", label = TRUE, repel = TRUE) +
    NoLegend()
)
dev.off()

pdf("all_integrated_annotation_by_condition.pdf", width = 13, height = 9)
print(
  DimPlot(
    all_integrated,
    reduction = "umap",
    group.by = "celltype",
    split.by = "Condition",
    label = FALSE,
    ncol = 2
  )
)
dev.off()

# Cell-type counts and proportions calculated separately for each sample.
celltype_counts <- as.data.frame(table(
  Sample_Name = all_integrated$Sample_Name,
  Condition = all_integrated$Condition,
  Cell_type = all_integrated$celltype
))
celltype_counts <- celltype_counts %>%
  group_by(Sample_Name) %>%
  mutate(Proportion_within_sample = Freq / sum(Freq)) %>%
  ungroup()
write.csv(
  celltype_counts,
  "celltype_counts_and_proportions_by_sample.csv",
  row.names = FALSE
)

celltype_distribution_plot <- ggplot(
  celltype_counts,
  aes(x = Sample_Name, y = Proportion_within_sample, fill = Cell_type)
) +
  geom_col() +
  facet_grid(~Condition, scales = "free_x", space = "free_x") +
  scale_y_continuous(labels = scales::percent_format()) +
  labs(x = "Sample", y = "Cell-type proportion", fill = "Cell type") +
  theme_classic() +
  theme(axis.text.x = element_text(angle = 90, hjust = 1))

ggsave(
  "celltype_distribution_by_sample.pdf",
  celltype_distribution_plot,
  width = 13,
  height = 5
)

saveRDS(
  all_integrated,
  "all_integrated_annotation.rds"
)

plan("sequential")
message("Integration and annotation are complete.")
